rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access to prevent unauthorized data exposure
    match /{document=**} {
      allow read, write: if false;
    }

    // Strict User-Isolated Hierarchy: /users/{userId}
    // Only the authenticated owner matching request.auth.uid can access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollection: /users/{userId}/journals/{journalId}
      match /journals/{journalId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Subcollection: /users/{userId}/analytics/{analyticsId}
      match /analytics/{analyticsId} {
        allow read, create, update: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
